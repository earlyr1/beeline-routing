# Скопируйте в .env и заполните. Пустые значения допустимы: сервис работает без них.
# Ключ JavaScript API Яндекс Карт (кабинет разработчика: developer.tech.yandex.ru)
# Ограничение по HTTP Referer в кабинете: localhost. Открывать приложение только по http://localhost:8000
YANDEX_MAPS_API_KEY=
# OpenAI-совместимый API для вкладки «Рекомендуемые изменения».
# Примеры адресов: https://openrouter.ai/api/v1, https://api.deepseek.com, http://host.docker.internal:11434/v1 (Ollama).
# Имя модели берётся у провайдера. Без LLM_BASE_URL и LLM_MODEL помощник выключен, остальное работает.
# Проверенная бесплатная связка: OpenRouter, ключ из openrouter.ai/settings/keys, модель nex-agi/nex-n2.5-mini:free.
# Запасная на случай 429 у провайдера: inclusionai/ling-3.0-flash-vl:free.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# auto: инструменты, при отказе провайдера JSON; tools: только инструменты; json: только JSON в тексте ответа
LLM_TOOL_MODE=auto
# nominatim: геокодировать новые адреса через OSM; cache-only: только data/geocode_cache.json
GEOCODER=nominatim
# Лимит времени OR-Tools на один пересчёт, секунды. С лимитом 5 посчитана таблица результатов в README
SOLVER_TIME_LIMIT_S=5
# Процессов для поиска OR-Tools: несколько стратегий идут одновременно, берётся лучший план. 1 — без пула.
# Пусто — по числу ядер, но не больше 4
SOLVER_WORKERS=
# Postgres, в котором живёт день диспетчера. В docker-compose.yml он подставляется сам, и менять эти
# значения не нужно: база наружу не торчит и живёт только внутри compose. Уберите DATABASE_URL и блок
# depends_on: postgres из compose — день вернётся в память процесса и будет теряться при перезапуске backend.
# Сервис рассчитан ровно на один процесс backend: второй на той же базе испортит чужой день.
#POSTGRES_DB=routing
#POSTGRES_USER=routing
#POSTGRES_PASSWORD=routing
# Сам адрес базы. В compose он собирается из значений выше, задавать его тут нужно только при запуске
# backend руками (uvicorn, тесты хранилища). Пусто — день живёт в памяти процесса.
#DATABASE_URL=postgresql://routing:routing@localhost:5432/routing
